# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://archaeologist:archaeologist@localhost:5432/archaeologist

# GitHub Access Token (Optional for public repos, required for GraphQL API v4 & higher rate limits)
GITHUB_TOKEN=

# AI / LLM Configuration (Phase 4 Investigation Engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
